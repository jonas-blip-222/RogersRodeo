# Vorlage. Diese Datei enthaelt absichtlich kein Geheimnis und ist versioniert.
# Echte Werte gehoeren in eine Datei .env daneben; die steht in .gitignore.
#
# Anlegen, ohne den Schluessel im Terminalverlauf zu hinterlassen:
#   read -rs OPENROUTER_API_KEY && printf 'OPENROUTER_API_KEY=%s\n' "$OPENROUTER_API_KEY" > .env && unset OPENROUTER_API_KEY
#
# Alternative ohne Datei, fuer die App der einzig brauchbare Weg (macOS-Schluesselbund):
#   security add-generic-password -a "$USER" -s rogersrodeo-openrouter -w

OPENROUTER_API_KEY=
